# =============================================================================
# HKEx Filing Scraper — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is loaded from the CURRENT WORKING DIRECTORY, not the repo root.
# =============================================================================

# ---------------------------------------------------------------------------
# Database sink selection (REQUIRED)
# ---------------------------------------------------------------------------
# An ordered, comma-separated list of sink ids. Every configured sink is
# written to; reads come from the first sink that supports them.
# Valid ids:
#   postgres    PostgreSQL 13+    (extra: postgres)
#   mysql       MySQL 8           (extra: mysql)
#   mariadb     MariaDB 10.5+     (extra: mysql)
#   sqlite      SQLite file       (no extra)
#   duckdb      DuckDB file       (extra: duckdb)
#   mongodb     MongoDB 6+        (extra: mongodb)
#   clickhouse  ClickHouse 24+    (extra: clickhouse)
#   neo4j       Neo4j 5           (extra: neo4j)
#   surrealdb   SurrealDB         (no extra)
#
# Examples:
#   DATABASE_TARGET=postgres
#   DATABASE_TARGET=postgres,sqlite
#   DATABASE_TARGET=mysql,clickhouse
DATABASE_TARGET=postgres

# ---------------------------------------------------------------------------
# PostgreSQL (required when DATABASE_TARGET includes postgres)
# ---------------------------------------------------------------------------
# Install the driver first:  pip install "hkex-filing-scraper[postgres]"
#
# Either provide a full connection string...
POSTGRES_DSN=
# ...or the discrete settings below (used when POSTGRES_DSN is empty).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=public
# Connection pool sizing (OPTIONAL)
# POSTGRES_MIN_POOL=1
# POSTGRES_MAX_POOL=15

# ---------------------------------------------------------------------------
# MySQL / MariaDB (required when DATABASE_TARGET includes mysql or mariadb)
# ---------------------------------------------------------------------------
# Install the driver first:  pip install "hkex-filing-scraper[mysql]"
#
# MYSQL_DSN=mysql://user:password@localhost:3306/hkex
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# The mariadb sink reads MARIADB_* and falls back to MYSQL_* when its own are unset.
# MARIADB_DSN=
# MARIADB_HOST=localhost
# MARIADB_PORT=3306
# MARIADB_DATABASE=
# MARIADB_USER=
# MARIADB_PASSWORD=

# ---------------------------------------------------------------------------
# SQLite / DuckDB (required when DATABASE_TARGET includes sqlite or duckdb)
# ---------------------------------------------------------------------------
# SQLite needs no extra dependency.
# DuckDB:  pip install "hkex-filing-scraper[duckdb]"
#
# SQLITE_PATH=hkex.db          # a file path, or :memory:
# DUCKDB_PATH=hkex.duckdb      # a file path, or :memory:

# ---------------------------------------------------------------------------
# MongoDB (required when DATABASE_TARGET includes mongodb)
# ---------------------------------------------------------------------------
# Install the driver first:  pip install "hkex-filing-scraper[mongodb]"
#
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DATABASE=hkex

# ---------------------------------------------------------------------------
# ClickHouse (required when DATABASE_TARGET includes clickhouse)
# ---------------------------------------------------------------------------
# Install the driver first:  pip install "hkex-filing-scraper[clickhouse]"
#
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_DATABASE=hkex
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=

# ---------------------------------------------------------------------------
# Neo4j (required when DATABASE_TARGET includes neo4j)
# ---------------------------------------------------------------------------
# Install the driver first:  pip install "hkex-filing-scraper[neo4j]"
#
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=

# ---------------------------------------------------------------------------
# SurrealDB (required when DATABASE_TARGET includes surrealdb)
# ---------------------------------------------------------------------------
# No extra dependency.
#
# SURREAL_ENDPOINT=http://localhost:8000
# SURREAL_NAMESPACE=default
# SURREAL_DATABASE=default
# SURREAL_USERNAME=root
# SURREAL_PASSWORD=

# ---------------------------------------------------------------------------
# Graph linking (OPTIONAL)
# ---------------------------------------------------------------------------
# Set COMPANY_TABLE to the name of your existing company table to enable
# graph edges (has_filing, references_filing) between companies and filings.
# Leave empty to disable graph linking entirely.
#
# COMPANY_TABLE=my_company
#
# Pattern for converting a ticker like "0451.HK" into a company key.
# Placeholders: {code} = leading-zero-stripped stock code, {exchange} = exchange suffix.
# Default: "{code}_{exchange}" produces "451_HK"
#
# COMPANY_ID_PATTERN={code}_{exchange}

# ---------------------------------------------------------------------------
# Performance tuning (OPTIONAL)
# ---------------------------------------------------------------------------
# MAX_DOWNLOAD_WORKERS=15
