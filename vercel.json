{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "mkdocs build --strict",
  "outputDirectory": "site",
  "functions": {
    "api/mcp.py": {
      "runtime": "python3.12",
      "maxDuration": 60,
      "memory": 1024,
      "regions": ["hkg1"],
      "functionFailoverRegions": ["sin1"]
    }
  },
  "rewrites": [{ "source": "/mcp", "destination": "/api/mcp" }]
}
