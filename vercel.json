{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "buildCommand": "mkdocs build --strict",
  "outputDirectory": "site",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 300,
      "regions": ["hkg1"],
      "functionFailoverRegions": ["sin1"],
      "excludeFiles": "{site/**,docs/**,tests/**,.github/**,scripts/**,overrides/**,mkdocs.yml,**/*.md}"
    }
  }
}
