{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.simonplmak-cloud/hkex-filings",
  "title": "HKEx Filings",
  "description": "Live HKEx (Hong Kong Stock Exchange) regulatory filings for AI agents.",
  "version": "2.4.0",
  "websiteUrl": "https://hkex-listco-updates.ascent-partners.com/",
  "repository": {
    "url": "https://github.com/simonplmak-cloud/hkex-filing-scraper",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://hkex-listco-updates.ascent-partners.com/api/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "hkex-filing-scraper",
      "version": "2.4.0",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "hkex-filing-scraper"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "hkex-scraper-mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
